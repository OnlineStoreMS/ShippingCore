{
  "manifest_version": 3,
  "name": "OSMS 快递助手·手机版",
  "version": "1.4.6",
  "description": "OpsMobile 远程打单：配对、领任务；打印弹窗用下拉选打印机后打印并发货。",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://*.kdzs.com/*",
    "http://*.kdzs.com/*",
    "https://*.zfcycle.com/*",
    "http://*.zfcycle.com/*",
    "https://osms.zfcycle.com/*",
    "http://localhost:5181/*",
    "http://127.0.0.1:5181/*",
    "http://192.168.3.41:5181/*",
    "http://192.168.3.41:8080/*",
    "http://192.168.3.41:8443/*",
    "https://192.168.3.41:8443/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "OSMS 快递助手·手机版",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.kdzs.com/*",
        "http://*.kdzs.com/*"
      ],
      "js": [
        "content/kdzs-automate.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
